#!/usr/bin/env python3
# zerotwo: танец 02 символами в терминале, крутится по кругу.
#   запуск: zerotwo      выход: Ctrl+C
# Чем мельче шрифт в терминале (Ctrl + -), тем детальнее картинка.
import base64, shutil, sys, time, zlib

RAMP = " .:-=+*#%@"   # от тёмного к яркому
FPS = 24

def load():
    raw = zlib.decompress(base64.b64decode(DATA))
    return raw[0] << 8 | raw[1], raw[2], raw[3], raw[4:]

def render(f, w, h, lum, cols, rows):
    # ячейка терминала примерно вдвое выше, чем шире
    R = min(rows, int(cols * h / (2 * w)))
    C = min(cols, int(R * 2 * w / h))
    padl = " " * ((cols - C) // 2)
    padr = " " * (cols - C - len(padl))
    blank = " " * cols
    lines = [blank] * ((rows - R) // 2)
    base = f * w * h
    nr = len(RAMP)
    for r in range(R):
        ya = int(r * h / R); yb = max(ya + 1, int((r + 1) * h / R))
        ys = (ya, (ya + yb - 1) // 2, yb - 1)
        line = [padl]
        for c in range(C):
            xa = int(c * w / C); xb = max(xa + 1, int((c + 1) * w / C))
            xs = (xa, (xa + xb - 1) // 2, xb - 1)
            s = k = 0
            for y in ys:
                row = base + y * w
                for x in xs:
                    v = lum[row + x]
                    if v:
                        s += v; k += 1
            if k < 3:                      # в основном фон
                line.append(" ")
            else:
                line.append(RAMP[min(nr - 1, (s // 9) * nr // 256)])
        line.append(padr)
        lines.append("".join(line))
    lines += [blank] * (rows - len(lines))
    return "\033[H" + "\n".join(lines)

def main():
    w, h, n, lum = load()
    out = sys.stdout
    out.write("\033[?25l\033[2J")
    cache, size, i = {}, None, 0
    try:
        while True:
            t = time.time()
            cs = shutil.get_terminal_size()
            if cs != size:                 # окно изменилось: перерисовываем под новый размер
                size, cache = cs, {}
                out.write("\033[2J")
            if i not in cache:
                cache[i] = render(i, w, h, lum, cs.columns, cs.lines - 1)
            out.write(cache[i]); out.flush()
            i = (i + 1) % n
            time.sleep(max(0, 1 / FPS - (time.time() - t)))
    except KeyboardInterrupt:
        pass
    finally:
        out.write("\033[2J\033[H\033[?25h"); out.flush()

